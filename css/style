:root{
  --sky-deep:#0F2A55;
  --ink:#10233F;
  --slate:#57688A;
  --paper:#F3F7FC;
  --cloud:#FFFFFF;
  --tint:#E6EFFC;
  --sky:#2F86FF;
  --teal:#00B39E;
  --teal-2:#00967F;
  --line:rgba(16,35,63,0.09);
}
*{box-sizing:border-box; margin:0; padding:0;}
html{scroll-behavior:smooth;}
body{
  font-family:'Manrope',sans-serif;
  background:var(--paper);
  color:var(--ink);
  -webkit-font-smoothing:antialiased;
  overflow-x:hidden;
}
h1,h2,h3,.disp{font-family:'Fraunces',serif; font-optical-sizing:auto;}
.mono{font-family:'IBM Plex Mono',monospace;}
a{text-decoration:none; color:inherit;}
img{max-width:100%; display:block;}
.wrap{max-width:1180px; margin:0 auto; padding:0 24px;}

/* status strip */
.ticker{
  background:var(--tint);
  color:var(--sky-deep);
  font-size:12.5px;
  letter-spacing:.02em;
  border-bottom:1px solid var(--line);
}
.ticker .wrap{display:flex; align-items:center; gap:10px; padding:8px 24px; overflow:hidden; white-space:nowrap;}
.dot{width:7px; height:7px; border-radius:50%; background:var(--teal); flex:none; box-shadow:0 0 0 3px rgba(0,179,158,0.18); animation:pulse 2s ease-in-out infinite;}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.45}}
.ticker span.sep{color:#9FB2CE;}

/* nav */
header{
  background:rgba(255,255,255,0.88);
  backdrop-filter:blur(10px);
  position:sticky; top:0; z-index:50;
  border-bottom:1px solid var(--line);
}
nav{display:flex; align-items:center; justify-content:space-between; padding:14px 24px;}
.brand{display:flex; align-items:center; gap:10px;}
.brand img{width:36px; height:36px; border-radius:50%; background:#fff; object-fit:cover; box-shadow:0 2px 8px rgba(16,35,63,0.12);}
.brand .name{color:var(--ink); font-weight:700; font-size:17px; letter-spacing:-0.01em; font-family:'Fraunces',serif;}
.brand .name em{color:var(--teal); font-style:normal;}
.navlinks{display:flex; gap:34px; align-items:center;}
.navlinks a{color:var(--ink); font-size:12.5px; font-weight:700; letter-spacing:.08em; text-transform:uppercase; transition:color .15s; position:relative; padding-bottom:6px;}
.navlinks a:hover{color:var(--teal-2);}
.navlinks a.active{color:var(--teal-2);}
.navlinks a.active::after{content:""; position:absolute; left:0; right:0; bottom:0; height:2px; background:var(--teal);}
.navcta{background:var(--teal); color:#fff !important; padding:9px 18px; border-radius:99px; font-weight:700 !important; font-size:13.5px !important;}
.burger{display:none; color:var(--ink); font-size:24px; background:none; border:none; cursor:pointer; line-height:1; padding:6px;}
.burger:focus-visible, a:focus-visible, button:focus-visible{outline:2px solid var(--teal); outline-offset:2px;}

/* hero */
.hero{
  background:
    linear-gradient(90deg, rgba(243,247,252,0.97) 0%, rgba(243,247,252,0.75) 34%, rgba(243,247,252,0.18) 56%, rgba(243,247,252,0.05) 100%),
    url("../images/hero-bg.webp") center 30% / cover no-repeat;
  color:var(--ink);
  position:relative;
  padding:64px 0 88px;
  overflow:hidden;
  min-height:640px;
  display:flex;
  align-items:center;
}
.hero-grid{position:relative; display:block; width:100%;}
.hero-copy{max-width:560px;}
.eyebrow-txt{font-family:'IBM Plex Mono',monospace; font-size:12px; letter-spacing:.08em; text-transform:uppercase; color:var(--teal-2); margin-bottom:16px; font-weight:600;}
.hero h1{
  font-family:'Fraunces',serif; font-weight:600; text-transform:uppercase;
  font-size:clamp(26px, 6vw, 44px); line-height:1.12; letter-spacing:.005em; margin-bottom:20px;
}
.hero h1 .grad{color:var(--teal-2);}
.hero p.lead{font-size:18px; line-height:1.55; color:var(--slate); max-width:460px; margin-bottom:34px; font-weight:500;}
.hero-ctas{display:flex; gap:14px; flex-wrap:wrap;}
.btn-primary{background:var(--teal); color:#fff; padding:16px 30px; border-radius:99px; font-weight:700; font-size:13.5px; letter-spacing:.06em; text-transform:uppercase; display:inline-flex; align-items:center; gap:8px; transition:transform .15s, background .15s; box-shadow:0 16px 28px -12px rgba(0,179,158,0.5);}
.btn-primary:hover{background:var(--teal-2); transform:translateY(-1px);}
.btn-ghost{border:1.5px solid var(--ink); color:var(--ink); padding:16px 30px; border-radius:99px; font-weight:700; font-size:13.5px; letter-spacing:.06em; text-transform:uppercase;}
.btn-ghost:hover{background:rgba(16,35,63,0.06);}
.iso{display:none;}
.blob{display:none;}
.cloud-line{position:absolute; opacity:.9; pointer-events:none;}
@media(max-width:900px){
  .hero{min-height:auto; padding:48px 0 56px; background-position:68% 22% !important;}
  .hero::before{content:""; position:absolute; inset:0; background:rgba(243,247,252,0.88);}
  .hero-copy{position:relative;}
  .cloud-line{display:none !important;}
}
@media(max-width:520px){
  .hero{background-position:72% 20% !important;}
}
.btn-primary:hover{background:var(--teal-2); transform:translateY(-1px);}

/* forecast card (signature) */
.term{
  background:#fff; border:1px solid var(--line); border-radius:22px;
  box-shadow:0 30px 60px -24px rgba(16,35,63,0.22);
  overflow:hidden;
}
.term-bar{display:flex; align-items:center; justify-content:space-between; gap:7px; padding:16px 20px; border-bottom:1px solid var(--line); background:var(--tint);}
.term-bar .loc{font-family:'IBM Plex Mono',monospace; font-size:11.5px; color:var(--sky-deep); font-weight:600;}
.term-bar .badge{font-family:'IBM Plex Mono',monospace; font-size:10.5px; color:var(--teal-2); background:rgba(0,179,158,0.14); padding:4px 9px; border-radius:99px;}
.term-body{padding:24px 20px;}
.fc-main{display:flex; align-items:center; gap:16px; margin-bottom:18px;}
.fc-icon{font-size:40px; line-height:1;}
.fc-temp{font-family:'Fraunces',serif; font-size:34px; font-weight:600; color:var(--ink);}
.fc-sub{font-size:12.5px; color:var(--slate); margin-top:2px;}
.fc-row{display:flex; justify-content:space-between; align-items:center; padding:11px 0; border-top:1px dashed var(--line); font-size:13px; color:var(--slate);}
.fc-row .v{color:var(--teal-2); font-weight:700; font-family:'IBM Plex Mono',monospace; font-size:12.5px;}

/* stats */
.stats{background:#fff; border-bottom:1px solid var(--line);}
.stats .wrap{display:grid; grid-template-columns:repeat(4,1fr); gap:0;}
.stat{padding:34px 20px; text-align:center; border-right:1px solid var(--line);}
.stat:last-child{border-right:none;}
.stat .num{font-family:'Fraunces',serif; font-size:34px; font-weight:600; color:var(--ink);}
.stat .num span{color:var(--teal);}
.stat .lbl{font-size:12.5px; color:var(--slate); margin-top:4px; letter-spacing:.02em;}

/* section shared */
section{padding:88px 0;}
.tag{font-family:'IBM Plex Mono',monospace; font-size:12px; letter-spacing:.06em; color:var(--teal-2); text-transform:uppercase; margin-bottom:12px; display:flex; align-items:center; gap:8px;}
.tag::before{content:""; width:16px; height:1px; background:var(--teal-2);}
.sec-h{font-size:clamp(24px, 4vw, 32px); font-weight:600; letter-spacing:-0.01em; color:var(--ink); max-width:640px; margin-bottom:14px;}
.sec-p{color:var(--slate); font-size:15.5px; line-height:1.7; max-width:560px;}
.sec-head{margin-bottom:48px;}

/* services */
.services-grid{display:grid; grid-template-columns:repeat(3,1fr); gap:22px;}
.svc{background:#fff; border:1px solid var(--line); border-radius:20px; padding:28px; transition:box-shadow .15s, transform .15s; cursor:pointer; position:relative; -webkit-tap-highlight-color:transparent; outline:none;}
.svc:focus-visible{box-shadow:0 0 0 3px rgba(0,179,158,0.35);}
.svc:hover{box-shadow:0 20px 34px -18px rgba(16,35,63,0.18); transform:translateY(-3px);}
.svc .ic{width:44px; height:44px; border-radius:12px; background:var(--tint); display:flex; align-items:center; justify-content:center; color:var(--teal-2); margin-bottom:16px;}
.svc h3{font-size:17px; font-weight:600; margin-bottom:8px; color:var(--ink); font-family:'Fraunces',serif; padding-right:26px;}
.svc p{font-size:13.8px; color:var(--slate); line-height:1.6;}
.svc-chevron{position:absolute; top:28px; right:24px; width:20px; height:20px; color:var(--teal-2); transition:transform .25s ease;}
.svc.open .svc-chevron{transform:rotate(180deg);}
.svc-detail{max-height:0; overflow:hidden; transition:max-height .3s ease, margin-top .3s ease; font-size:13.3px; color:var(--slate); line-height:1.65; border-top:1px dashed var(--line); margin-top:0;}
.svc.open .svc-detail{max-height:220px; margin-top:16px; padding-top:14px;}

/* pricing */
.pricing{background:#fff; border-top:1px solid var(--line);}
.price-grid{display:grid; grid-template-columns:repeat(3,1fr); gap:22px;}
.price-card{background:var(--paper); border:1px solid var(--line); border-radius:20px; padding:30px; position:relative; display:flex; flex-direction:column;}
.price-card.featured{background:var(--sky-deep); border-color:var(--sky-deep); color:#fff;}
.price-badge{position:absolute; top:-12px; left:24px; background:var(--teal); color:#fff; font-size:10.5px; font-weight:700; letter-spacing:.04em; text-transform:uppercase; padding:5px 12px; border-radius:99px;}
.price-card h3{font-family:'Fraunces',serif; font-size:20px; font-weight:600; margin-bottom:4px;}
.price-sub{font-size:13px; color:var(--slate); margin-bottom:8px;}
.price-card.featured .price-sub{color:#B9CCE8;}
.price-amt{font-family:'Fraunces',serif; font-size:26px; font-weight:600; margin:0 0 2px;}
.price-amt-note{font-size:12px; font-weight:400; color:var(--slate);}
.price-card.featured .price-amt-note{color:#B9CCE8;}
.price-domain{font-size:12.5px; color:var(--slate); margin-bottom:20px;}
.price-card.featured .price-domain{color:#B9CCE8;}
.price-feat{list-style:none; margin-bottom:26px; flex:1 0 auto;}
.price-feat li{font-size:13.5px; padding:9px 0; border-top:1px solid var(--line); display:flex; align-items:center; gap:8px;}
.price-feat li:first-child{border-top:none;}
.price-feat li::before{content:"✓"; color:var(--teal); font-weight:700;}
.price-card.featured .price-feat li{border-color:rgba(255,255,255,0.14);}
.price-cta{display:block; text-align:center; padding:13px; border-radius:99px; font-weight:700; font-size:13px; background:var(--teal); color:#fff; margin-top:auto;}
.price-cta:hover{background:var(--teal-2);}
@media(max-width:900px){.price-grid{grid-template-columns:1fr;}}

/* process */
.process{background:var(--tint);}
.proc-grid{display:grid; grid-template-columns:repeat(5,1fr); gap:18px;}
.proc{background:#fff; border:1px solid var(--line); border-radius:16px; padding:22px 18px; cursor:pointer; transition:box-shadow .15s, transform .15s; position:relative; -webkit-tap-highlight-color:transparent; outline:none;}
.proc:focus-visible{box-shadow:0 0 0 3px rgba(0,179,158,0.35);}
.proc:hover{box-shadow:0 20px 34px -18px rgba(16,35,63,0.18); transform:translateY(-3px);}
.proc-n{font-family:'IBM Plex Mono',monospace; font-size:12px; font-weight:700; color:#00735F; display:block; margin-bottom:10px;}
.proc h3{font-family:'Fraunces',serif; font-size:15.5px; font-weight:600; color:var(--ink); margin-bottom:6px; padding-right:20px;}
.proc p{font-size:12.5px; color:var(--slate); line-height:1.55;}
.proc-chevron{position:absolute; top:22px; right:16px; width:16px; height:16px; color:var(--teal-2); transition:transform .25s ease;}
.proc.open .proc-chevron{transform:rotate(180deg);}
.proc-detail{max-height:0; overflow:hidden; transition:max-height .3s ease, margin-top .3s ease; font-size:12.3px; color:var(--slate); line-height:1.6; border-top:1px dashed var(--line); margin-top:0;}
.proc.open .proc-detail{max-height:220px; margin-top:12px; padding-top:12px;}
@media(max-width:900px){.proc-grid{grid-template-columns:repeat(3,1fr);}}
@media(max-width:700px){.proc-grid{grid-template-columns:repeat(2,1fr);}}
@media(max-width:560px){.proc-grid{grid-template-columns:1fr;}}

/* live projects / case studies */
.work{background:#fff; border-top:1px solid var(--line);}
.case-grid{display:grid; grid-template-columns:repeat(3,1fr); gap:24px;}
.case{background:var(--paper); border:1px solid var(--line); border-radius:20px; overflow:hidden; transition:box-shadow .15s, transform .15s;}
.case:hover{box-shadow:0 20px 34px -18px rgba(16,35,63,0.18); transform:translateY(-3px);}
.case-visual{height:130px; display:flex; align-items:center; justify-content:center;}
.case-organic{background:linear-gradient(135deg,#00B39E,#0F2A55);}
.case-fashion{background:linear-gradient(135deg,#2F86FF,#10233F);}
.case-media{background:linear-gradient(135deg,#10233F,#3D5A99);}
.case-body{padding:22px;}
.case-status{display:inline-block; font-family:'IBM Plex Mono',monospace; font-size:10.5px; font-weight:600; letter-spacing:.05em; text-transform:uppercase; padding:4px 10px; border-radius:99px; margin-bottom:12px;}
.case-status.live{background:rgba(0,179,158,0.14); color:var(--teal-2);}
.case-status.build{background:rgba(47,134,255,0.14); color:#1B5FE0;}
.case-status.vision{background:rgba(16,35,63,0.08); color:var(--slate);}
.case h3{font-family:'Fraunces',serif; font-size:19px; font-weight:600; color:var(--ink); margin-bottom:4px;}
.case-cat{font-size:12px; color:#00735F; font-weight:600; margin-bottom:10px;}
.case-desc{font-size:13.5px; color:var(--slate); line-height:1.6; margin-bottom:14px;}
.case-tags{display:flex; flex-wrap:wrap; gap:6px; margin-bottom:16px;}
.case-tags span{font-size:11px; font-family:'IBM Plex Mono',monospace; background:#fff; border:1px solid var(--line); color:var(--slate); padding:4px 9px; border-radius:99px;}
.case-link{font-size:13px; font-weight:700; color:var(--teal-2);}
.case-link:hover{color:var(--teal);}
.case-link.muted{color:var(--slate); font-weight:600;}
@media(max-width:900px){.case-grid{grid-template-columns:repeat(2,1fr);}}
@media(max-width:640px){.case-grid{grid-template-columns:1fr;}}

/* industries slider */
.industries{background:var(--sky-deep);}
.industries .tag{color:#7FE0D0;}
.industries .tag::before{background:#7FE0D0;}
.industries .sec-h, .industries .sec-p{color:#fff;}
.industries .sec-p{color:#B9CCE8;}
.slider{display:flex; gap:18px; overflow-x:auto; scroll-snap-type:x mandatory; padding-bottom:14px; margin:0 -24px; padding-left:24px; padding-right:24px;}
.slider::-webkit-scrollbar{height:6px;}
.slider::-webkit-scrollbar-thumb{background:#2A4A78; border-radius:4px;}
.slide{
  flex:0 0 300px; scroll-snap-align:start;
  background:#fff; border-radius:18px; overflow:hidden;
  box-shadow:0 20px 34px -18px rgba(0,0,0,0.35);
}
.slide img{width:100%; height:170px; object-fit:cover;}
.slide .cap{padding:16px 18px;}
.slide .cap p.cap-t{color:var(--ink); font-size:14.5px; font-weight:700; margin-bottom:4px; font-family:'Fraunces',serif;}
.slide .cap p{color:var(--slate); font-size:12.5px;}

/* why us */
.why{display:grid; grid-template-columns:1fr 1fr; gap:64px; align-items:center;}
.why-list{list-style:none;}
.why-list li{display:flex; gap:16px; padding:18px 0; border-top:1px solid var(--line);}
.why-list li:last-child{border-bottom:1px solid var(--line);}
.why-list .n{font-family:'IBM Plex Mono',monospace; color:var(--teal); font-size:13px; padding-top:2px;}
.why-list p.why-t{font-size:16px; font-weight:700; color:var(--ink); margin-bottom:4px; font-family:'Fraunces',serif;}
.why-list p{font-size:13.8px; color:var(--slate); line-height:1.6;}
.why-visual{background:var(--tint); border:1px solid var(--line); border-radius:22px; padding:26px; color:var(--ink);}
.mini-stat{display:flex; justify-content:space-between; align-items:center; padding:14px 0; border-bottom:1px solid var(--line); font-family:'IBM Plex Mono',monospace; font-size:13px;}
.mini-stat:last-child{border-bottom:none;}
.mini-stat .v{color:var(--teal-2); font-weight:700;}

/* about */
.about-wrap{display:grid; grid-template-columns:0.9fr 1.1fr; gap:56px; align-items:start;}
.founder-quote{font-family:'Fraunces',serif; font-style:italic; font-size:17px; line-height:1.5; color:var(--ink); border-left:3px solid var(--teal); padding-left:18px; margin-top:22px;}
.about-card{background:#fff; border:1px solid var(--line); border-radius:22px; padding:30px; box-shadow:0 20px 34px -20px rgba(16,35,63,0.12);}
.about-card .row{display:flex; justify-content:space-between; align-items:flex-start; gap:16px; padding:12px 0; border-top:1px dashed var(--line); font-size:13.8px;}
.about-card .row:first-child{border-top:none;}
.about-card .row .k{color:var(--slate); flex-shrink:0;}
.about-card .row .v{font-weight:700; color:var(--ink); text-align:right;}
@media(max-width:600px){
  .about-card .row{flex-direction:column; align-items:flex-start; gap:4px; padding:14px 0;}
  .about-card .row .v{text-align:left; width:100%;}
}

/* contact */
.contact{background:var(--sky-deep); color:#fff;}
.contact-grid{display:grid; grid-template-columns:1fr 1fr; gap:56px;}
.contact .tag{color:#7FE0D0;} .contact .tag::before{background:#7FE0D0;}
.contact h2{color:#fff;}
.contact p.sec-p{color:#B9CCE8;}
.clist{margin-top:28px; display:flex; flex-direction:column; gap:18px;}
.citem{display:flex; gap:14px; align-items:flex-start;}
.citem .ic{width:38px; height:38px; border-radius:11px; background:rgba(255,255,255,0.10); display:flex; align-items:center; justify-content:center; color:#fff; flex:none;}
.citem p.citem-t{font-size:14px; font-weight:700; margin-bottom:2px; color:#fff; font-family:'Fraunces',serif;}
.citem p, .citem a{font-size:13.8px; color:#B9CCE8;}
.citem a:hover{color:#7FE0D0;}
.cta-card{background:#fff; border-radius:22px; padding:32px; color:var(--ink);}
@media (hover: none), (pointer: coarse){
  [data-tilt]{transform:none !important;}
}
.cta-card h3{font-size:20px; margin-bottom:8px; font-family:'Fraunces',serif; font-weight:600;}
.cta-card p{font-size:13.8px; color:var(--slate); margin-bottom:22px; line-height:1.6;}
.enquiry-form{display:flex; flex-direction:column; gap:11px;}
.sr-only{position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0;}
.enquiry-form input, .enquiry-form select, .enquiry-form textarea{
  width:100%; padding:12px 14px; border:1px solid var(--line); border-radius:10px;
  font-family:'Manrope',sans-serif; font-size:13.5px; color:var(--ink); background:var(--paper);
}
.enquiry-form input:focus, .enquiry-form select:focus, .enquiry-form textarea:focus{outline:2px solid var(--teal); outline-offset:1px;}
.enquiry-form textarea{resize:vertical;}
.cbtn{display:block; text-align:center; padding:14px; border-radius:99px; font-weight:700; font-size:14px; margin-bottom:12px;}
.cbtn.whatsapp{background:var(--teal); color:#fff;}
.cbtn.call{border:1.5px solid var(--line); color:var(--ink);}
.cbtn.call:hover{background:var(--tint);}

footer{background:var(--paper); color:var(--slate); padding:56px 0 28px; border-top:1px solid var(--line);}
.footer-grid{display:grid; grid-template-columns:1.6fr 1fr 1fr 1fr 1fr; gap:32px; margin-bottom:36px;}
.footer-brand .fbrand{color:var(--ink); font-weight:700; font-family:'Fraunces',serif; font-size:17px;}
.footer-brand p{font-size:12.5px; color:var(--slate); margin-top:8px; line-height:1.6;}
.footer-copy{margin-top:16px !important;}
.footer-col h4{font-size:12px; font-weight:700; letter-spacing:.05em; text-transform:uppercase; color:var(--ink); margin-bottom:14px;}
.footer-col a{display:block; font-size:13px; color:var(--slate); margin-bottom:10px;}
.footer-col a:hover{color:var(--teal-2);}
@media(max-width:900px){
  .footer-grid{grid-template-columns:repeat(2,1fr); gap:28px;}
  .footer-brand{grid-column:1/-1;}
}

@media(max-width:900px){
  .hero-grid{grid-template-columns:1fr;}
  .stats .wrap{grid-template-columns:repeat(2,1fr);}
  .stat:nth-child(2){border-right:none;}
  .services-grid{grid-template-columns:1fr 1fr;}
  .why{grid-template-columns:1fr;}
  .about-wrap{grid-template-columns:1fr;}
  .contact-grid{grid-template-columns:1fr;}
  .navlinks{
    display:none; position:absolute; top:100%; left:0; right:0;
    flex-direction:column; align-items:flex-start; gap:0;
    background:#fff; border-top:1px solid var(--line);
    box-shadow:0 16px 24px -12px rgba(16,35,63,0.15);
  }
  .navlinks.open{display:flex;}
  .nav
